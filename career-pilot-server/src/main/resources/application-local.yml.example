# ============================================================
# 本地开发配置模板
#
# 使用步骤：
#   1. 在同目录下复制本文件，重命名为 application-local.yml
#   2. 按下方注释填入真实值
#
# 注意：
#   - application-local.yml 已被 .gitignore 忽略，不会进入版本库
#   - 真实凭据只写在该文件里，不要写进 application.yml 或本模板
#   - 相关约定见《系统架构设计》第 7、9 节
# ============================================================

spring:
  datasource:
    # MySQL 账号。库名与连接串在 application.yml 中，通常无需改动
    username: root
    password: 请填写数据库密码

  ai:
    deepseek:
      # DeepSeek API Key，获取地址 https://platform.deepseek.com
      #
      # 注意：Spring AI 的自动配置强制要求该项非空，缺失会导致应用启动失败
      # （现象与解法见《问题记录 · 配置与启动》第 1 节）
      api-key: 请填写 DeepSeek API Key

app:
  jwt:
    # JWT 签名密钥，HS256 要求不少于 32 字节（256 bit）。
    # 生成方式：openssl rand -base64 48
    #
    # 提示：本项一旦泄露，他人即可伪造任意用户的 Token，且服务端不做 Token 撤销，
    # 只能通过更换密钥使全部已签发 Token 立即失效。
    secret: 请填写随机密钥

  file:
    # 阿里云 OSS 存储实现（仅 app.file.storage-type=oss 时使用，见《系统架构设计》7.1）。
    #
    # 准备事项：
    #   1. endpoint 填外网访问域名（如 oss-cn-beijing.aliyuncs.com，非 -internal 内网域名）
    #   2. 建议使用 RAM 子账号 AccessKey，权限限定为该 bucket 的
    #      GetObject / PutObject / DeleteObject，不要使用主账号 AK
    #   3. bucket 的「阻止公共访问」需关闭（默认开启；不关则对象级公共读 ACL 会被拒绝，
    #      头像地址将无法访问）
    oss:
      endpoint: 请填写 OSS 外网 endpoint
      bucket: 请填写 bucket 名称
      access-key-id: 请填写 AccessKey ID
      access-key-secret: 请填写 AccessKey Secret
